package com.example.rpapp3.data

import android.content.Context
import androidx.datastore.core.DataStore
import androidx.datastore.preferences.core.Preferences
import androidx.datastore.preferences.core.edit
import androidx.datastore.preferences.core.intPreferencesKey
import androidx.datastore.preferences.core.stringPreferencesKey
import androidx.datastore.preferences.preferencesDataStore
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.first
import kotlinx.coroutines.flow.map

private val Context.dataStore: DataStore<Preferences> by preferencesDataStore(name = "api_keys")
private const val GEMINI_API_KEY_SEPARATOR = "|||"

internal fun parseGeminiApiKeyList(keysString: String): List<String> {
    if (keysString.isBlank()) return emptyList()
    return keysString.split(GEMINI_API_KEY_SEPARATOR).filter { it.isNotBlank() }
}

internal fun serializeGeminiApiKeyList(keys: Collection<String>): String {
    return keys.joinToString(GEMINI_API_KEY_SEPARATOR)
}

internal fun geminiDefaultKeysToSync(
    currentKeys: Collection<String>,
    removedDefaultKeys: Collection<String>,
    defaultKeys: Collection<String>
): List<String> {
    val currentKeySet = currentKeys.toSet()
    val removedDefaultKeySet = removedDefaultKeys.toSet()
    return defaultKeys.filter { defaultKey ->
        defaultKey !in currentKeySet && defaultKey !in removedDefaultKeySet
    }
}

internal fun markGeminiDefaultKeyRemoved(
    key: String,
    removedDefaultKeys: Set<String>,
    defaultKeys: Collection<String>
): Set<String> {
    return if (key in defaultKeys) {
        removedDefaultKeys + key
    } else {
        removedDefaultKeys
    }
}

internal fun unmarkGeminiDefaultKeyRemoved(
    key: String,
    removedDefaultKeys: Set<String>
): Set<String> {
    return removedDefaultKeys - key
}

/**
 * API Key Manager for Gemini API.
 * 
 * To set up:
 * 1. Go to https://aistudio.google.com/apikey
 * 2. Create one or more API keys
 * 3. Create a copy of this file named ApiKeyManager.kt
 * 4. Replace the placeholder API keys below with your actual keys
 */
class ApiKeyManager(private val context: Context) {
    
    companion object {
        private val API_KEYS_KEY = stringPreferencesKey("api_keys")
        private val REMOVED_DEFAULT_API_KEYS_KEY = stringPreferencesKey("removed_default_api_keys")
        private val CURRENT_INDEX_KEY = intPreferencesKey("current_key_index")
        
        // TODO: Replace with your Gemini API keys
        // You can add multiple keys for rotation when quota is exhausted
        private val DEFAULT_API_KEYS = listOf(
            "YOUR_GEMINI_API_KEY_1",
            "YOUR_GEMINI_API_KEY_2"
        )
        
        @Volatile
        private var INSTANCE: ApiKeyManager? = null
        
        fun getInstance(context: Context): ApiKeyManager {
            return INSTANCE ?: synchronized(this) {
                INSTANCE ?: ApiKeyManager(context.applicationContext).also { INSTANCE = it }
            }
        }
    }
    
    /**
     * Flow of all API keys in the pool
     */
    val apiKeys: Flow<List<String>> = context.dataStore.data.map { preferences ->
        val keysString = preferences[API_KEYS_KEY] ?: ""
        parseGeminiApiKeyList(keysString)
    }
    
    /**
     * Flow of the current key index
     */
    val currentKeyIndex: Flow<Int> = context.dataStore.data.map { preferences ->
        preferences[CURRENT_INDEX_KEY] ?: 0
    }
    
    /**
     * Initialize with default API keys if not already set.
     * Also syncs any new default keys that were added to DEFAULT_API_KEYS.
     */
    suspend fun initializeDefaults() {
        val currentKeys = apiKeys.first()
        val removedDefaultKeys = context.dataStore.data.map { preferences ->
            parseGeminiApiKeyList(preferences[REMOVED_DEFAULT_API_KEYS_KEY] ?: "")
        }.first()

        if (currentKeys.isEmpty() && removedDefaultKeys.isEmpty()) {
            context.dataStore.edit { preferences ->
                preferences[API_KEYS_KEY] = serializeGeminiApiKeyList(DEFAULT_API_KEYS)
                preferences[CURRENT_INDEX_KEY] = 0
            }
        } else {
            val newDefaultKeys = geminiDefaultKeysToSync(
                currentKeys = currentKeys,
                removedDefaultKeys = removedDefaultKeys,
                defaultKeys = DEFAULT_API_KEYS
            )
            if (newDefaultKeys.isNotEmpty()) {
                context.dataStore.edit { preferences ->
                    val updatedKeys = currentKeys + newDefaultKeys
                    preferences[API_KEYS_KEY] = serializeGeminiApiKeyList(updatedKeys)
                }
            }
        }
    }
    
    /**
     * Get the currently active API key
     */
    suspend fun getCurrentApiKey(): String? {
        val keys = apiKeys.first()
        val index = currentKeyIndex.first()
        return keys.getOrNull(index)
    }
    
    /**
     * Add a new API key to the pool
     */
    suspend fun addApiKey(key: String) {
        if (key.isBlank()) return
        val trimmedKey = key.trim()
        context.dataStore.edit { preferences ->
            val currentKeys = preferences[API_KEYS_KEY] ?: ""
            val keysList = parseGeminiApiKeyList(currentKeys).toMutableList()
            
            // Don't add duplicates
            if (!keysList.contains(trimmedKey)) {
                keysList.add(trimmedKey)
                preferences[API_KEYS_KEY] = serializeGeminiApiKeyList(keysList)
                
                // Reset index to 0 so the new key gets a chance to be used
                // This helps when all previous keys were exhausted
                preferences[CURRENT_INDEX_KEY] = 0
            }

            val removedDefaultKeys = parseGeminiApiKeyList(
                preferences[REMOVED_DEFAULT_API_KEYS_KEY] ?: ""
            ).toSet()
            val updatedRemovedDefaultKeys = unmarkGeminiDefaultKeyRemoved(
                key = trimmedKey,
                removedDefaultKeys = removedDefaultKeys
            )
            preferences[REMOVED_DEFAULT_API_KEYS_KEY] = serializeGeminiApiKeyList(updatedRemovedDefaultKeys)
        }
    }
    
    /**
     * Remove an API key from the pool
     */
    suspend fun removeApiKey(key: String) {
        val trimmedKey = key.trim()
        context.dataStore.edit { preferences ->
            val currentKeys = preferences[API_KEYS_KEY] ?: ""
            val keysList = parseGeminiApiKeyList(currentKeys).toMutableList()
            if (keysList.isEmpty()) return@edit
            
            val removedIndex = keysList.indexOf(trimmedKey)
            if (removedIndex == -1) return@edit
            keysList.removeAt(removedIndex)
            
            preferences[API_KEYS_KEY] = serializeGeminiApiKeyList(keysList)

            val removedDefaultKeys = parseGeminiApiKeyList(
                preferences[REMOVED_DEFAULT_API_KEYS_KEY] ?: ""
            ).toSet()
            val updatedRemovedDefaultKeys = markGeminiDefaultKeyRemoved(
                key = trimmedKey,
                removedDefaultKeys = removedDefaultKeys,
                defaultKeys = DEFAULT_API_KEYS
            )
            preferences[REMOVED_DEFAULT_API_KEYS_KEY] = serializeGeminiApiKeyList(updatedRemovedDefaultKeys)
            
            // Adjust current index if needed
            val currentIndex = preferences[CURRENT_INDEX_KEY] ?: 0
            if (keysList.isEmpty()) {
                preferences[CURRENT_INDEX_KEY] = 0
            } else if (removedIndex <= currentIndex) {
                // If we removed a key at or before current index, adjust
                preferences[CURRENT_INDEX_KEY] = maxOf(0, currentIndex - 1) % keysList.size
            }
        }
    }
    
    /**
     * Rotate to the next API key in the pool
     * Returns the new current key, or null if no keys available
     */
    suspend fun rotateToNextKey(): String? {
        context.dataStore.edit { preferences ->
            val currentKeys = preferences[API_KEYS_KEY] ?: ""
            if (currentKeys.isBlank()) return@edit
            
            val keysList = parseGeminiApiKeyList(currentKeys)
            if (keysList.isEmpty()) return@edit
            
            val currentIndex = preferences[CURRENT_INDEX_KEY] ?: 0
            val nextIndex = (currentIndex + 1) % keysList.size
            preferences[CURRENT_INDEX_KEY] = nextIndex
        }
        
        return getCurrentApiKey()
    }
    
    /**
     * Reset the key index to 0 (start from the first key)
     * Useful when quotas have reset or when trying again after all keys were exhausted
    */
    suspend fun resetKeyIndex() {
        context.dataStore.edit { preferences ->
            preferences[CURRENT_INDEX_KEY] = 0
        }
    }
    
    /**
     * Set the active API key by index
     * Allows manual selection of which key to use
     */
    suspend fun setActiveKeyIndex(index: Int) {
        val keys = apiKeys.first()
        if (index >= 0 && index < keys.size) {
            context.dataStore.edit { preferences ->
                preferences[CURRENT_INDEX_KEY] = index
            }
        }
    }
    
    /**
     * Check if an error message indicates a temporary rate limit (429) - should wait and retry same key
     * Note: "resource exhausted" is NOT included here because it typically means quota is truly exhausted,
     * not just a temporary rate limit.
     */
    fun isRateLimitError(errorMessage: String?): Boolean {
        if (errorMessage == null) return false
        val lowerMessage = errorMessage.lowercase()
        // Only match true rate limit errors (429 Too Many Requests)
        // Do NOT include "resource exhausted" here - that's a quota error
        return (lowerMessage.contains("429") ||
                lowerMessage.contains("rate limit") ||
                lowerMessage.contains("too many requests")) &&
                !lowerMessage.contains("quota") &&
                !lowerMessage.contains("resource exhausted")
    }
    
    /**
     * Check if an error message indicates quota exceeded - should switch to next key
     * This includes "resource exhausted" errors from Gemini API
     */
    fun isQuotaExhaustedError(errorMessage: String?): Boolean {
        if (errorMessage == null) return false
        val lowerMessage = errorMessage.lowercase()
        return lowerMessage.contains("quota") ||
                lowerMessage.contains("resource exhausted") ||
                lowerMessage.contains("resource_exhausted") ||
                lowerMessage.contains("free_tier") ||
                lowerMessage.contains("exceeded") ||
                lowerMessage.contains("overloaded") ||
                lowerMessage.contains("model is overloaded") ||
                lowerMessage.contains("503") ||
                (lowerMessage.contains("limit") && lowerMessage.contains("0"))
    }
    
    /**
     * Check if an error message indicates a quota error that should trigger key rotation
     * This is separate from rate limit errors which should just retry with the same key
     */
    fun isQuotaError(errorMessage: String?): Boolean {
        return isQuotaExhaustedError(errorMessage)
    }
}
